#!/usr/bin/env bash

# A note about behavior! Consider the following example:
# 
#   alias ls='ls $LS_OPTIONS'
#   alias ll='ls -laFo'
# 
# In the above case we override the ls command with our own alias. 
# The ll alias will then call our ls alias, which will expand to "ls $LS_OPTIONS -laFo". 
# If this is not what you want, you must `unalias ls` to go back to the behavior of the 
# original `ls` command. OR you can create your aliases like this: 
#
#   alias ll='command ls -laFo'
#
# There are other places in the code where this is done, so be aware of this behavior 
# when creating new aliases.

# A function to add an alias to the current shell and
# append it to this file
adda () {
    local name=$1 value="$2"
    echo alias "$name"=\'"$value"\' >> ~/dotfiles/.bash_alias
    eval alias "$name"=\'"$value"\'
    alias "$name"
}

#### USER SPECIFIC ALIASES AND FUNCTIONS
# show all user-specific aliases:
alias sa='alias -p'

# Enable colors
if [[ "$PLATFORM" == "Linux" ]]; then
    if [ -x /usr/bin/dircolors ]; then
        LS_OPTIONS='--color=auto'
        test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    fi
fi

if [[ "$PLATFORM" == "FreeBSD" ]]; then
    LS_OPTIONS='--color=always'
fi

export LS_OPTIONS

if [ "$TERM" != "dumb" ]; then
    if [[ "$PLATFORM" == "Linux" ]]; then
        alias ls='ls $LS_OPTIONS'
        alias ll='ls -laFo'
        alias l='ls -l'
        alias lr='ls -R'      #recursive ls
        alias l.=' ls -lhFa --time-style=long-iso --ignore=lost+found'
        alias dots='ls -ldFh .*'

        alias dira='ls -alFh --group-directories-first --time-style=long-iso'
        alias dirr='ls -alFhtr --group-directories-first --time-style=long-iso'

        alias logs="sudo find /var/log -type f -exec file {} \; | grep 'text' | cut -d' ' -f1 | sed -e's/:$//g' | grep -v '[0-9]$' | xargs tail -f"
    fi
    if [[ "$PLATFORM" == "FreeBSD" ]]; then
        alias ls='ls $LS_OPTIONS'
        alias ll='ls -laFG'
        alias l='ls -l'
        alias lr='ls -R'
        alias dots='ls -ldFh .*'

        alias dira='ls -alFGhp -D "%F %T"'
        alias dirr='ls -alFGhtr'
    fi
fi

# Awesome ls replacement:
alias dir='eza -l -a -h -F -t modified -s newest --icons --group-directories-first --smart-group --time-style="+%Y-%m-%d %H:%M:%S"'
# Output as tree:
alias dirt='eza -l -a -h -F -T -t modified -s newest --icons --group-directories-first --smart-group --time-style=long-iso'

# SEARCHING ALIASES
alias grep='grep $LS_OPTIONS'
alias grepn='grep -n'
alias fgrep='fgrep $LS_OPTIONS'
alias egrep='egrep -n $LS_OPTIONS'

## NAVIGATION ALIASES
# get rid of command not found ##
alias cd..='cd ..'

# a quick way to get out of current directory ##
alias ..='cd ..'
alias .2='cd ../..'
alias .3='cd ../../..'
alias .4='cd ../../../..'
alias .5='cd ../../../../..'

# go back to previous directory
alias back='cd -'

### QUERY THE HW
## get top process eating memory
alias psmem='ps aux | sort -nr -k 4'
alias psmem10='ps aux | sort -nr -k 4 | head -10'

## get top process eating cpu ##
alias pscpu='ps aux | sort -nr -k 3'
alias pscpu10='ps aux | sort -nr -k 3 | head -10'


## SYSADMIN STUFF

# reboot / halt / poweroff
alias reboot='sudo /sbin/reboot'
alias poweroff='sudo /sbin/poweroff'

# become root #
alias root='sudo -s'

# change mode
alias rw-='chmod 600'
alias rwx='chmod 700'
alias r--='chmod 644'
alias r-x='chmod 755'

# safety features
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'
alias ln='ln -i'

# networking
alias ping='ping -c 5'
alias fping='ping -c 100 -s 2'

# get web server headers #
alias header='curl -I'
# find out if remote server supports gzip / mod_deflate or not #
alias headerc='curl -I --compress'
alias wget='wget -c'

## MISCELLANEOUS

# modified existing commands
alias more='less'
alias nano='nano -w'

# new commands
alias da='date "+%A, %B %d, %Y [%T]"'
alias now='date "+%F %T"'
alias hist='history | grep'      # requires an argument
alias pl='ps aux | less'
alias c='clear'
alias q='exit'
alias j='jobs -l'
alias h='history'
alias pu="pushd"
alias po="popd"
alias hn='hostname'
alias reload='. ~/.bashrc'
alias space='sudo ncdu -x -e -2 --color dark ./'

# LINUX ONLY Aliases
if [[ "$PLATFORM" == "Linux" || "$PLATFORM" == "CYGWIN_NT" || "$PLATFORM" == "MINGW64_NT" ]]; then
    ## pass options to free ##
    alias meminfo='free -l'

    ## Get server cpu info ##
    alias cpuinfo='lscpu'

    alias dmesg='sudo dmesg -t'
    alias sysinfo='inxi -Fxxxrza'

    ## get GPU ram on desktop / laptop##
    alias gpumeminfo='grep -i --color memory /var/log/Xorg.0.log'
    alias rm='rm -I'                    # 'rm -i' prompts for every file
    alias chown='chown --preserve-root'
    alias chmod='chmod --preserve-root'
    alias chgrp='chgrp --preserve-root'

    # system updates
    if [ -f /etc/debian_version ]; then
        alias ins='sudo apt-get install'
        alias update='sudo apt-get update && sudo apt-get upgrade --show-upgraded -y'
    elif [ -f /etc/redhat-release ]; then
        alias ins='sudo yum install'
        alias update='sudo yum -v -y check-update && sudo yum -v -y upgrade'
    elif [ -f /etc/arch-release ]; then
        alias ins='sudo pacman -Sy'
        alias update='sudo pacman -Syu'
    fi

    # copy a stream into the X clipboard; e.g. "cat file | xcopy"
    alias xcopy="xclip -i -selection clipboard"

    ## shortcut  for iptables and pass it via sudo#
    alias ipt='sudo /sbin/iptables'

    # display all rules #
    alias iptlist='sudo /sbin/iptables -L -n -v --line-numbers'
    alias iptlistin='sudo /sbin/iptables -L INPUT -n -v --line-numbers'
    alias iptlistout='sudo /sbin/iptables -L OUTPUT -n -v --line-numbers'
    alias iptlistfw='sudo /sbin/iptables -L FORWARD -n -v --line-numbers'
    alias firewall=iptlist

    alias ports='netstat -tulanp'
    alias openports='ss --all --numeric --processes --ipv4 --ipv6'

    # df pretty
    alias dfp='df -Tha --sync --total -x squashfs -x tmpfs -x devtmpfs'
    alias dus='du -ach | sort -h'
    alias du1='du -ach --max-depth=1'
    alias free='free -mt'
    alias pwdu='du -Pschx .[!.]* ./* 2>/dev/null'
fi

if [[ "$PLATFORM" == "FreeBSD" ]]; then
    alias ports='lsof -n -i | grep LISTEN'
    alias df='df -Ha -,'
    alias dus='du -akx | sort -n'
    alias du1='du -s'
    alias nukeds="find ./ -type f | grep .DS_Store | xargs rm"
    alias htop='sudo htop'
fi

#EOF
