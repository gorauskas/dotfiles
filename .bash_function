#!/usr/bin/env bash
# shellcheck disable=SC2009

# make a backup file
function bak() {
    cp "$1" "${1}-$(date +%Y%m%d%H%M%S).bak"
}

# cd + ls
function cdl() {
    local folder="$1"
    local folder="${folder:=$HOME}"
    if [[ -d "$folder" ]]; then
        cd "$folder" >/dev/null || exit; dir
    else
        echo "bash: cdl '$folder' - Directory not found"
    fi
}

# counts regular files, symbolic links, and directories in the 
# current directory tree and prints the count for each type
function cfiles() {
    for t in files links directories; do
        echo "$(find . -type "${t:0:1}" | wc -l) $t"
    done 2>/dev/null
}

# change mode, owner, and group of a file
function chmog() {
    if [ $# -ne 4 ]; then
        echo "usage: chmog mode owner group file"
        return 1
    else
        chmod "$1" "$4"
        chown "$2" "$4"
        chgrp "$3" "$4"
    fi
}

# clean a directory by removing all temp and backup files
# that were left behind
function clean() {
    echo -n "Are you sure you want to clean this directory? [y/n] "
    read -r yorn
    if test "$yorn" = "y"; then
        rm -f \#* *~ .*~ *.bak .*.bak *.tmp .*.tmp core a.out
        echo "Directory has been cleaned!"
    else
        echo "Clean operation has been aborted..."
    fi
}

# Display Environment Information
function envinfo() {
    local i
    local is
    let ic=0

    for i in "${BASH_VERSINFO[@]}";
    do
        if [ $ic = 5 ]; then
            is="$is on a $i"
        else
            if [ $ic = 0 ]; then
                is="Bash Version $i"
            elif [ $ic = 1 ]; then
                is="$is.$i"
            elif [ $ic = 2 ]; then
                is="$is.$i("
            elif [ $ic = 3 ]; then
                is="$is$i)/"
            elif [ $ic = 4 ]; then
                is="$is$i"
            fi
        fi
        let ic=$ic+1
    done
    echo "$is"
}

# extract archives based on extension
function extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar -jxvf "$1"                                    ;;
            *.tar.gz)    tar -zxvf "$1"                                    ;;
            *.tar.xz)    tar -xvf "$1"                                     ;;
            *.tar)       tar -xvf "$1"                                     ;;
            *.tbz2)      tar -jxvf "$1"                                    ;;
            *.tgz)       tar -zxvf "$1"                                    ;;
            *.7z)        7z x "$1"                                         ;;
            *.bz2)       bunzip2 -k "$1"                                   ;;
            *.cab)       cabextract "$1"                                   ;;
            *.gz)        gunzip "$1"                                       ;;
            *.jar)       jar -xvf "$1"                                     ;;
            *.rar)       unrar x "$1"                                      ;;
            *.xz)        unxz "$1"                                         ;;
            *.Z)         uncompress "$1"                                   ;;
            *.ZIP)       unzip "$1"                                        ;;
            *.zip)       unzip "$1"                                        ;;
            *.zst)       unzstd "$1"                                       ;;
            *)           echo "'$1' cannot be uncompressed with extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# requires superuser access in order to look at
# all nooks and crannies
function findall() {
    sudo find / -mount -name "*${1}*" -print ;
}

# Watch output written to file
function fwatch() {
    if [ $# -ne 1 ]; then
        tail -f nohup.out
    else
        tail -f "$1"
    fi
}

# make and cd into directory
function mcd() {
    mkdir -p "$1" && cd "$1" || exit;
}

# create 16 char password using /dev/urandom
function mkpwd() {
    LC_ALL=C tr -dc '[:graph:]' < /dev/urandom | head -c "${1:-16}"; echo;
}

# musical ping - requires the sox package be isntalled
function mping() {
    ping "$@" | awk -F[=\ ] '/time=/{t=$(NF-1);f=2000-14*log(t^18);c="play -q -n synth 1 pl "f"&";print $0;system(c)}';
}

# page with `most` if present, otherwise use `less`
function pg() {
    if [ -x "$(command -v most)" ]; then
        most "$1";
    else
        less "$1";
    fi
}

# Find a process by name
function psgrep() {
    ps aux | grep -v grep | grep -i -e VSZ -e "$1"
}

# Kill a process by Name
function pskill() {
    local pid
    pid=$(ps ax | grep -i -e "$1" | grep -v grep | awk '{ print $1 }')
    echo -n "Killing $1 (Process $pid) ..."
    kill -9 "$pid"
    echo "Slaughtered ..."
}



function rot13() {
    if (($#)); then
        printf '%s\n' "$*" | tr 'A-Za-z' 'N-ZA-Mn-za-m'
    else
        tr 'A-Za-z' 'N-ZA-Mn-za-m'
    fi
}

# Start a simple python httpd on the current directory at the given port
function websrv() {
    command -v python >/dev/null 2>&1 || { echo >&2 "I require python but it's not installed.  Aborting."; exit 1; }
    if [ "$(python -c 'import sys; print(sys.version_info[0])')" -eq 2 ]; then
        python -m SimpleHTTPServer "$@"
    else
        python -m http.server "$@"
    fi
}

# LINUX ONLY
if [[ "$PLATFORM" == "Linux" ]]; then

    # Open any document with any application
    function open() {
        T=$(xdg-mime query filetype "$1")
        WITH=$(xdg-mime query default "$T")
        echo "Opening file" "$1" "of type" "$T" "with" "$WITH"
        xdg-open "$1"
        echo "Open done!"
    }

fi
