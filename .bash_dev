# LS Dir Output for developers:
alias dird='eza -l -a -h -F -@ -t modified -s newest --icons --group-directories-first --smart-group --time-style=long-iso --loc --git --git-repos'
alias devlog='eza --code --icons'

alias diff='colordiff'              # requires colordiff package
alias d='diff'
alias g='git'
alias gw='./gradlew'

# emacs
alias e='emacsclient -ca emacs'
# alias em=emacs # conflicts with MicroEmacs em
alias emdi='emacs --debug-init'
alias enw='emacs -nw'
alias qem='emacs -q'
alias sem='sudo emacs'

# lisp
alias lisp='rlwrap sbcl'
alias csi='rlwrap chicken-csi'
alias guile='rlwrap guile'
alias gambit='gambitc'

# python
# The 2 aliases to ipython below are changing to ensure that ipython is
# loaded from inside an venv when in one
alias ipy="python3 -c 'from IPython import start_ipython; start_ipython()'"

alias py3='python3'
alias py='python'

# Git commit and push - CAP
function cap() {
    git add . ;
    git commit -m "$1" ;
    git pull ;
    git push ;
}

# Git compare local to remote - GDR git diff remote
function gdr() {
    git fetch origin ;
    git diff "$1"..origin/"$1";
}

