#!/usr/bin/env bash
# shellcheck disable=SC1091

# software development related stuff

# python
if [[ "$PLATFORM" == "Linux" ]]; then
    if [[ "${DISTRO}" == "Arch" || "${DISTRO}" == "ManjaroLinux" || "${DISTRO}" == "cachyos" ]]; then
        export VIRTUALENVWRAPPER_SCRIPT=/usr/bin/virtualenvwrapper.sh
        [ -f /usr/bin/virtualenvwrapper_lazy.sh ] && . /usr/bin/virtualenvwrapper_lazy.sh
    fi

    if [[ "${DISTRO}" == "Debian" || "${DISTRO}" == "Ubuntu" ]]; then
        export VIRTUALENVWRAPPER_SCRIPT=/usr/local/bin/virtualenvwrapper.sh
        [ -f /usr/local/bin/virtualenvwrapper_lazy.sh ] && . /usr/local/bin/virtualenvwrapper_lazy.sh
    fi

    # enable bash completion in interactive shells
    if [[ "${DISTRO}" == "Arch" || "${DISTRO}" == "ManjaroLinux" || "${DISTRO}" == "cachyos" ]]; then
        if [ -f /usr/share/bash-completion/bash_completion ] && ! shopt -oq posix; then
            . /usr/share/bash-completion/bash_completion
        fi
        if [ -f /usr/share/doc/pkgfile/command-not-found.bash ]; then
            . /usr/share/doc/pkgfile/command-not-found.bash
        fi
    fi

    if [[ "${DISTRO}" == "Debian" || "${DISTRO}" == "Ubuntu" ]]; then
        if [ -f /etc/bash_completion ] && ! shopt -oq posix; then
            . /etc/bash_completion
        fi
    fi
fi

if [[ "$PLATFORM" == "FreeBSD" ]]; then
    export VIRTUALENVWRAPPER_SCRIPT=/usr/local/bin/virtualenvwrapper.sh
    [ -f /usr/local/bin/virtualenvwrapper_lazy.sh ] && . /usr/local/bin/virtualenvwrapper_lazy.sh
    [ -f /usr/local/etc/bash_completion ] && . /usr/local/etc/bash_completion
fi

# QMK Firmware
if [ -d "$HOME/Projects/qmk_firmware" ] ; then
    export QMK_HOME="$HOME/Projects/qmk_firmware"
    export QMK_FIRMWARE="$HOME/Projects/qmk_firmware"
    export QMK_VERBOSE="True"
    export QMK_DATETIME_FMT="%Y-%m-%d %H:%M:%S"
    export QMK_LOG_FMT="%(levelname)s %(message)s"
    export QMK_LOG_FILE_FMT="[%(levelname)s] [%(asctime)s] [file:%(pathname)s] [line:%(lineno)d] %(message)s"
    export QMK_LOG_FILE_LEVEL="info"
    export QMK_LOG_FILE="None"
    export QMK_COLOR="True"
    export QMK_UNICODE="True"
    export QMK_INTERACTIVE="False"
fi

# hugo bash completions
if command -v hugo >/dev/null 2>&1; then
    # shellcheck disable=SC1090
    source <(hugo completion bash)
fi

# nvm / node
# This loads nvm
# [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  

# This loads nvm bash_completion
# [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  

# rust
[ -s "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"

# sdkman
#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
# export SDKMAN_DIR="$HOME/.sdkman"
# [[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"


