! Notes:
!  to test, run the following to source the file:
!
!    xrdb < ~/.Xresources
!
!  ... and then start XTerm or URxvt to see the changes

!! Font defaults
Xft.dpi:        96
Xft.antialias:  true
Xft.rgba:       rgb
Xft.hinting:    true
Xft.autohint:   true
Xft.lcdfilter:  lcddefault

!! URxvt definitions
URxvt.preeditType:            Root
URxvt.perl-lib:               /usr/lib/urxvt/perl
URxvt.cursorBlink:            true
URxvt.depth:                  32
URxvt.geometry:               160x60
URxvt.imLocale:               en_US.UTF-8
URxvt.inheritPixmap:          false
URxvt.iso14755:               false
URxvt.iso14755_52:            false
URxvt.letterSpace:            -1
URxvt.saveLines:              32767
URxvt.scrollBar:              true
URxvt.scrollBar_right:        false
URxvt.scrollstyle:            plain
URxvt.termName:               rxvt-unicode-256color
URxvt.transparent:            false
URxvt.urgentOnBell:           true

URxvt*font:                   xft:EnvyCodeR Nerd Font Mono:pixelsize=14
URxvt*boldFont:               xft:EnvyCodeR Nerd Font Mono:bold:pixelsize=14

URxvt.perl-ext-common:        default,matcher,resize-font,selection-to-clipboard,tabbed

URxvt.underlineURLs:          true
URxvt.url-launcher:           /usr/bin/xdg-open
URxvt.matcher.button:         1
URxvt.matcher.rend.0:         Uline Bold fg8

URxvt.clipboard.autocopy:     true
URxvt.keysym.M-c:             perl:clipboard:copy
URxvt.keysym.M-v:             perl:clipboard:paste

URxvt.tabbed.tabbar-fg: 12
URxvt.tabbed.tabbar-bg: 8
URxvt.tabbed.tab-fg: 10
URxvt.tabbed.tab-bg: 0

!! xterm definitions
xterm*cursorBlink:            true
xterm*dynamicColors:          on
xterm*eightBitInput:          true
xterm*faceName:               EnvyCodeR Nerd Font Mono
xterm*faceSize:               11
xterm*geometry:               160x64
xterm*highlightSelection:     true
xterm*internalBorder:         10
xterm*loginShell:             true
xterm*metaSendsEscape:        true
xterm*multiClickTime:         250
xterm*renderFont:             true
xterm*saveLines:              32767
xterm*scaleHeight:            1.0
xterm*scrollBar:              true
xterm*scrollKey:              true
xterm*utf8:                   1

! --- URXVT + XTERM TERMINAL COLORS ---
#define cb00 #091310
#define cb01 #CE2029
#define cb02 #6FC7B0
#define cb03 #F5A500
#define cb04 #568CC5
#define cb05 #AB80C4
#define cb06 #65BFC4
#define cb07 #B7E3D8

#define cb08 #40514C
#define cb09 #F06D75
#define cb10 #8BDFC4
#define cb11 #FFD166
#define cb12 #80B9E8
#define cb13 #B89CE8
#define cb14 #8AE1E7
#define cb15 #E0F5EF

! special
*.foreground:   cb15
*.background:   cb00
*.cursorColor:  #FF7900
*fading: 35
*fadeColor: cb08

*.color0: cb00
*.color1: cb01
*.color2: cb02
*.color3: cb03
*.color4: cb04
*.color5: cb05
*.color6: cb06
*.color7: cb07
*.color8: cb08
*.color9: cb09
*.color10: cb10
*.color11: cb11
*.color12: cb12
*.color13: cb13
*.color14: cb14
*.color15: cb15
